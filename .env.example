# ─────────────────────────────────────────────────────────────────────────────
# StreamAN — contoh konfigurasi runtime.
# Salin jadi `.env.local` (dev) atau set di panel environment host (build).
# TIDAK ADA API KEY di project ini: Jikan & AniList adalah API publik tanpa key.
# ─────────────────────────────────────────────────────────────────────────────

# Backend internal berlisensi = SATU-SATUNYA sumber episode-stream yang sah.
# Bentuk yang diharapkan adapter (lihat src/lib/providers/gateway.ts):
#   GET {url}/v1/{otakudesu|kurama|oploverz}/trending?limit=
#   GET {url}/v1/{...}/latest?limit=
#   GET {url}/v1/{...}/search?q=&page=
#   GET {url}/v1/{...}/anime/{nativeId}
#   GET {url}/v1/{...}/anime/{nativeId}/episodes
#   GET {url}/v1/{...}/anime/{nativeId}/episode/{nativeEpisodeId}/sources
# Dibiarkan kosong => provider konten offline by design, Watch hanya menampilkan
# trailer resmi (tidak ada scraping/bypass di sisi klien).
VITE_STREAMAN_GATEWAY_URL=

# Override opsional bila ingin menunjuk instance sendiri / mirror.
VITE_STREAMAN_JIKAN_URL=https://api.jikan.moe/v4
VITE_STREAMAN_ANILIST_URL=https://graphql.anilist.co

# Host tambahan yang boleh dipakai <iframe>/<video> (CSV, tanpa protokol).
# Trailer YouTube/Vimeo/Crunchyroll sudah dipercaya secara bawaan.
VITE_STREAMAN_TRUSTED_MEDIA_HOSTS=





